# ==============================================================================
# Threat Intelligence Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# Threat Intelligence Data Providers
# ------------------------------------------------------------------------------
# VirusTotal API v3 (Free tier: 4 requests/min, 500/day)
# Get a key at: https://www.virustotal.com/gui/my-apikey
VT_API_KEY=your_virustotal_api_key_here

# Shodan API (Developer/Member key: 1 request/sec)
# Get a key at: https://account.shodan.io/
SHODAN_API_KEY=your_shodan_api_key_here

# NIST National Vulnerability Database (NVD) API 2.0
# Optional: without key = 5 req / 30s; with key = 50 req / 30s
# Request a key at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ------------------------------------------------------------------------------
# LLM Provider Configuration (openai | anthropic | ollama)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (required if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama local (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ------------------------------------------------------------------------------
# RAG & Embeddings Configuration
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma
RAG_TOP_K=4

# ------------------------------------------------------------------------------
# Cache & Rate Limiting Settings
# ------------------------------------------------------------------------------
CACHE_DIR=./.cache/diskcache
CACHE_TTL_SECONDS=86400
ENABLE_CACHE=true

# ------------------------------------------------------------------------------
# Agent Execution & Safety Limits
# ------------------------------------------------------------------------------
MAX_ITERATIONS=10
MAX_TOKENS_PER_EXECUTION=50000
LOG_LEVEL=INFO
